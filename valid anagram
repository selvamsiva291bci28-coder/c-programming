#include <stdbool.h>
#include <string.h>

bool isAnagram(char* s, char* t) {
    // Step 1: Check if lengths are different
    int len_s = strlen(s);
    int len_t = strlen(t);
    if (len_s != len_t) {
        return false;
    }

    // Step 2: Initialize frequency tracker for 26 lowercase English letters
    int count[26] = {0};

    // Step 3: Populate counts and subtract concurrently
    for (int i = 0; i < len_s; i++) {
        count[s[i] - 'a']++;
        count[t[i] - 'a']--;
    }

    // Step 4: Verify all counts returned to 0
    for (int i = 0; i < 26; i++) {
        if (count[i] != 0) {
            return false;
        }
    }

    return true;
}
