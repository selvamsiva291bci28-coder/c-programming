void merge(int* nums1, int nums1Size, int m, int* nums2, int nums2Size, int n) {
    // Pointers tracking the ends of valid data and the total array space
    int p1 = m - 1;
    int p2 = n - 1;
    int p = m + n - 1;
    
    // Compare and place elements from the back
    while (p1 >= 0 && p2 >= 0) {
        if (nums1[p1] > nums2[p2]) {
            nums1[p] = nums1[p1];
            p1--;
        } else {
            nums1[p] = nums2[p2];
            p2--;
        }
        p--;
    }
    
    // If elements remain in nums2, copy them over
    while (p2 >= 0) {
        nums1[p] = nums2[p2];
        p2--;
        p--;
    }
}
