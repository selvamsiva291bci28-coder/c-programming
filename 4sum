#include <stdio.h>
#include <stdlib.h>

// Comparison function for qsort
int compare(const void* a, const void* b) {
    int va = *(const int*)a;
    int vb = *(const int*)b;
    return (va > vb) - (va < vb); // Safe from integer underflow
}

int** fourSum(int* nums, int numsSize, int target, int* returnSize, int** returnColumnSizes) {
    int capacity = 16;
    int** result = (int**)malloc(capacity * sizeof(int*));
    *returnColumnSizes = (int*)malloc(capacity * sizeof(int));
    *returnSize = 0;

    if (numsSize < 4) {
        return result;
    }

    // Step 1: Sort the array to use two-pointer technique
    qsort(nums, numsSize, sizeof(int), compare);

    // Step 2: Loop for the first element
    for (int i = 0; i < numsSize - 3; i++) {
        // Skip duplicate values for the first element
        if (i > 0 && nums[i] == nums[i - 1]) continue;

        // Optimization 1: Smallest possible sum from here is greater than target
        if ((long)nums[i] + nums[i + 1] + nums[i + 2] + nums[i + 3] > target) break;
        
        // Optimization 2: Largest possible sum with this nums[i] is less than target
        if ((long)nums[i] + nums[numsSize - 3] + nums[numsSize - 2] + nums[numsSize - 1] < target) continue;

        // Step 3: Loop for the second element
        for (int j = i + 1; j < numsSize - 2; j++) {
            // Skip duplicate values for the second element
            if (j > i + 1 && nums[j] == nums[j - 1]) continue;

            // Optimization 3: Smallest possible sum from here is greater than target
            if ((long)nums[i] + nums[j] + nums[j + 1] + nums[j + 2] > target) break;
            
            // Optimization 4: Largest possible sum with this nums[i] and nums[j] is less than target
            if ((long)nums[i] + nums[j] + nums[numsSize - 2] + nums[numsSize - 1] < target) continue;

            int left = j + 1;
            int right = numsSize - 1;

            // Step 4: Two-pointer search for the last two elements
            while (left < right) {
                long sum = (long)nums[i] + nums[j] + nums[left] + nums[right];

                if (sum == target) {
                    // Resize storage arrays if capacity is reached
                    if (*returnSize >= capacity) {
                        capacity *= 2;
                        result = (int**)realloc(result, capacity * sizeof(int*));
                        *returnColumnSizes = (int*)realloc(*returnColumnSizes, capacity * sizeof(int));
                    }

                    // Allocate and store the unique quadruplet
                    result[*returnSize] = (int*)malloc(4 * sizeof(int));
                    result[*returnSize][0] = nums[i];
                    result[*returnSize][1] = nums[j];
                    result[*returnSize][2] = nums[left];
                    result[*returnSize][3] = nums[right];
                    (*returnColumnSizes)[*returnSize] = 4;
                    (*returnSize)++;

                    // Skip duplicate values to ensure unique results
                    while (left < right && nums[left] == nums[left + 1]) left++;
                    while (left < right && nums[right] == nums[right - 1]) right--;

                    left++;
                    right--;
                } else if (sum < target) {
                    left++;
                } else {
                    right--;
                }
            }
        }
    }

    return result;
}
