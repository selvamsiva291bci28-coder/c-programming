#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Structure to pair the original string pointer with its sorted version
typedef struct {
    char* original;
    char* sorted;
} AnagramPair;

// Comparator to sort characters within a single string
int compareChars(const void* a, const void* b) {
    return (*(char*)a - *(char*)b);
}

// Comparator to sort the pairs by their sorted string keys
int comparePairs(const void* a, const void* b) {
    return strcmp(((AnagramPair*)a)->sorted, ((AnagramPair*)b)->sorted);
}

char*** groupAnagrams(char** strs, int strsSize, int* returnSize, int** returnColumnSizes) {
    if (strsSize == 0) {
        *returnSize = 0;
        *returnColumnSizes = NULL;
        return NULL;
    }

    // Allocate array of pairs
    AnagramPair* pairs = malloc(strsSize * sizeof(AnagramPair));
    for (int i = 0; i < strsSize; i++) {
        pairs[i].original = strs[i];
        int len = strlen(strs[i]);
        
        // Copy and sort characters alphabetically to form the anagram key
        pairs[i].sorted = malloc((len + 1) * sizeof(char));
        strcpy(pairs[i].sorted, strs[i]);
        qsort(pairs[i].sorted, len, sizeof(char), compareChars);
    }

    // Sort all pairs by their sorted keys so that identical anagrams sit next to each other
    qsort(pairs, strsSize, sizeof(AnagramPair), comparePairs);

    // First pass: Count how many unique anagram groups exist
    int groupsCount = 0;
    for (int i = 0; i < strsSize; i++) {
        if (i == 0 || strcmp(pairs[i].sorted, pairs[i - 1].sorted) != 0) {
            groupsCount++;
        }
    }

    // Allocate memory for the return values requested by the LeetCode wrapper
    *returnSize = groupsCount;
    char*** result = malloc(groupsCount * sizeof(char**));
    *returnColumnSizes = malloc(groupsCount * sizeof(int));

    // Second pass: Group adjacent matching keys and fill the result array
    int groupIdx = 0;
    for (int i = 0; i < strsSize; ) {
        int j = i;
        // Find the boundary of the current anagram group
        while (j < strsSize && strcmp(pairs[i].sorted, pairs[j].sorted) == 0) {
            j++;
        }
        
        int groupSize = j - i;
        (*returnColumnSizes)[groupIdx] = groupSize;
        result[groupIdx] = malloc(groupSize * sizeof(char*));
        
        // Populate the group with the original strings
        for (int k = 0; k < groupSize; k++) {
            result[groupIdx][k] = pairs[i + k].original;
        }
        
        groupIdx++;
        i = j; // Move to the next unique anagram group
    }

    // Clean up temporary memory used for keys
    for (int i = 0; i < strsSize; i++) {
        free(pairs[i].sorted);
    }
    free(pairs);

    return result;
}
