#include <stdlib.h>
#include <math.h>

#define MAX(a, b) ((a) > (b) ? (a) : (b))
#define MIN(a, b) ((a) < (b) ? (a) : (b))

int maximumGap(int* nums, int numsSize) {
    if (numsSize < 2) {
        return 0;
    }

    // 1. Find the global minimum and maximum elements
    int min_val = nums[0];
    int max_val = nums[0];
    for (int i = 1; i < numsSize; i++) {
        if (nums[i] < min_val) min_val = nums[i];
        if (nums[i] > max_val) max_val = nums[i];
    }

    // If all elements are identical, the maximum gap is 0
    if (min_val == max_val) {
        return 0;
    }

    // 2. Calculate bucket size and count
    // The gap must be at least 1
    int bucket_size = MAX(1, (max_val - min_val) / (numsSize - 1));
    int bucket_count = (max_val - min_val) / bucket_size + 1;

    // 3. Initialize buckets to track min and max values within them
    int* bucket_min = malloc(bucket_count * sizeof(int));
    int* bucket_max = malloc(bucket_count * sizeof(int));
    int* bucket_has_elements = calloc(bucket_count, sizeof(int)); // 0 means empty

    for (int i = 0; i < bucket_count; i++) {
        bucket_min[i] = 2147483647; // INT_MAX
        bucket_max[i] = -2147483648; // INT_MIN
    }

    // 4. Map each number into its corresponding bucket
    for (int i = 0; i < numsSize; i++) {
        int idx = (nums[i] - min_val) / bucket_size;
        bucket_has_elements[idx] = 1;
        bucket_min[idx] = MIN(bucket_min[idx], nums[i]);
        bucket_max[idx] = MAX(bucket_max[idx], nums[i]);
    }

    // 5. Scan buckets sequentially to compute the maximum gap
    int max_gap = 0;
    int previous_bucket_max = min_val;

    for (int i = 0; i < bucket_count; i++) {
        if (!bucket_has_elements[i]) {
            continue; // Skip empty buckets
        }
        // Gap is the difference between current bucket's min and previous bucket's max
        max_gap = MAX(max_gap, bucket_min[i] - previous_bucket_max);
        previous_bucket_max = bucket_max[i];
    }

    // Free dynamically allocated arrays
    free(bucket_min);
    free(bucket_max);
    free(bucket_has_elements);

    return max_gap;
}
