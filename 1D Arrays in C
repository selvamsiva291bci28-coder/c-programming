#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    int n;
    
    // Safely read the size of the array
    if (scanf("%d", &n) != 1) {
        return 0;
    }
    
    // Dynamically allocate memory for n integers on the heap
    int *arr = (int*) malloc(n * sizeof(int));
    if (arr == NULL) {
        return 1; // Exit if memory allocation fails
    }
    
    // Read the space-separated integers into the allocated array
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &arr[i]) != 1) {
            free(arr);
            return 0;
        }
    }
    
    // Iterate through the array to calculate the total sum
    int sum = 0;
    for (int i = 0; i < n; i++) {
        sum += arr[i];
    }
    
    // Print the final sum to standard output
    printf("%d\n", sum);
    
    // Deallocate the memory to prevent memory leaks
    free(arr);
    
    return 0;
}
