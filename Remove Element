int removeElement(int* nums, int numsSize, int val) {
    int k = 0; // Pointer to track the position of valid elements
    
    for (int i = 0; i < numsSize; i++) {
        // If the current element is not equal to val, keep it
        if (nums[i] != val) {
            nums[k] = nums[i];
            k++;
        }
    }
    
    // k represents the total count of elements not equal to val
    return k; 
}
