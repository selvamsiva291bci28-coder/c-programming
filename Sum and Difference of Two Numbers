#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main()
{
    int int1, int2;
    float float1, float2;
    
    // Read two integers from the first line of input
    if (scanf("%d %d", &int1, &int2) != 2) return 0;
    
    // Read two float values from the second line of input
    if (scanf("%f %f", &float1, &float2) != 2) return 0;
    
    // Calculate and print the sum and difference of the integers
    printf("%d %d\n", int1 + int2, int1 - int2);
    
    // Calculate and print the sum and difference of the floats, 
    // formatted strictly to 1 decimal place using %.1f
    printf("%.1f %.1f\n", float1 + float2, float1 - float2);
    
    return 0;
}
